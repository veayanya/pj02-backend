# Salin file ini menjadi .env lalu isi nilainya.

# Kredensial iLovePDF (daftar gratis di https://developer.ilovepdf.com)
ILOVEPDF_PUBLIC_KEY=project_public_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ILOVEPDF_SECRET_KEY=secret_key_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Port server (Render akan mengisi otomatis lewat env PORT)
PORT=4000

# Origin frontend yang diizinkan mengakses API ini (CORS).
# Untuk banyak origin, pisahkan dengan koma. Boleh pakai "*" sebagai wildcard
# DI DALAM satu origin (bukan cuma "*" sendirian) supaya semua URL preview
# deployment Vercel (hash-nya berubah tiap deploy) otomatis diizinkan.
# Contoh:
#   https://konversin.vercel.app,http://localhost:5173
#   https://konversin-*-evaanyaaan-8098s-projects.vercel.app,http://localhost:5173
# ("*" sendirian tanpa apa pun = izinkan semua origin, cuma untuk testing)
CORS_ORIGIN=http://localhost:5173

# Batas ukuran file upload (MB)
MAX_FILE_SIZE_MB=50
